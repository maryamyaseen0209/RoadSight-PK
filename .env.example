# RoadSight-PK Environment Variables
PROJECT_NAME=RoadSight-PK
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
DEBUG=True

# SQLite Database
DATABASE_URL=sqlite:///./roadsight.db

# Storage Directories
OUTPUTS_DIR=artifacts/outputs
CHECKPOINTS_DIR=artifacts/checkpoints
METRICS_DIR=experiments/metrics

# Model Settings
DEFAULT_MODEL_TYPE=yolov8n
MODEL_WEIGHTS_PATH=artifacts/checkpoints/best_yolo.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
